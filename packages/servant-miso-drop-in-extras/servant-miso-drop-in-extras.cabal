cabal-version:      3.0
name:               servant-miso-drop-in-extras
version:            0.2.1.0
synopsis:           Extra servant API content types for servant-miso-client
description:        Extra content types and deriving helpers for servant-miso-client
homepage:           https://github.com/haskell-miso/servant-miso-client
license:            BSD-3-Clause
license-file:       LICENSE
author:             Clinton Mead (clintonmead@gmail.com)
maintainer:         code@dmj.io
category:           Web
build-type:         Simple

library
  ghc-options:
    -Weverything
    -Werror
    -Wno-missing-safe-haskell-mode
    -Wno-implicit-prelude
    -Wno-prepositive-qualified-module
    -Wno-missing-kind-signatures
    -Wno-missing-role-annotations
    -Wno-safe
    -Wno-unsafe
    -Wno-all-missed-specialisations
  exposed-modules:
      Servant.API.ContentTypes.DerivingVia
    , Servant.API.ContentTypes.Extra
  build-depends:
      base
    , http-media
    , servant-miso-drop-in-api
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  default-extensions:
      DerivingVia
    , PackageImports
  if !(impl(ghcjs) || arch(javascript) || arch(wasm32))
    cpp-options:
      -DVANILLA
