cabal-version: 3.0
name: servant-multipart-miso-drop-in-client-test-server
version: 0.1.0.0
license: BSD-3-Clause
synopsis: Native test server for servant-multipart-miso-drop-in-client
build-type: Simple

executable servant-multipart-miso-drop-in-client-test-server
  main-is: Main.hs
  hs-source-dirs:
    app
  default-extensions:
    TypeApplications
    RecordWildCards
  ghc-options: -Wall -Wunused-packages -Werror -threaded
  build-depends:
    base < 5,
    bytestring,
    servant-multipart-miso-drop-in-api,
    servant-multipart,
    servant-multipart-miso-drop-in-client-test-common,
    text,
    servant-server,
    warp
  default-language: Haskell2010