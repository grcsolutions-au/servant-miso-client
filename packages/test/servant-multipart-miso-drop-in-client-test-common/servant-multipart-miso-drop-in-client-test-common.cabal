cabal-version: 3.0
name: servant-multipart-miso-drop-in-client-test-common
version: 0.1.0.0
license: BSD-3-Clause
synopsis: Shared test API for servant-multipart-miso-drop-in-client
build-type: Simple

library
  exposed-modules:
    Servant.Multipart.Miso.Test.UploadTypes
  hs-source-dirs:
    src
  default-extensions:
    DataKinds
    DeriveGeneric
    DerivingStrategies
    FlexibleInstances
    MultiParamTypeClasses
    OverloadedStrings
    RecordWildCards
    TypeOperators
  ghc-options: -Wall -Wunused-packages -Werror
  build-depends:
    aeson,
    base < 5,
    bytestring,
    cryptohash-md5,
    miso,
    servant,
    servant-multipart-miso-drop-in-api,
    text
  default-language: Haskell2010