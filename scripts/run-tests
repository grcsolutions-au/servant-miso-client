#!/usr/bin/env bash

# An entirely vibe coded test script. Looks hack but seems to work.
# Almost certainly should be cleaned up.
# Intent is to run client in the following three modes:
#
# 1. Native
# 2. WASM
# 3. GHCJS
#
# Against a native test server.

set -euo pipefail

client_target=exe:servant-multipart-miso-drop-in-client-test-client
server_target=exe:servant-multipart-miso-drop-in-client-test-server
test_port=8090

project_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$project_root" || ! -f "$project_root/cabal.project" ]]; then
  printf 'test-servant-miso-client must be run from this repository\n' >&2
  exit 1
fi
cd "$project_root"

run_native_test() {
  printf '\n==> native client test\n'
  cabal build "$client_target" "$server_target"

  if (echo >/dev/tcp/127.0.0.1/"$test_port") 2>/dev/null; then
    printf 'test port %s is already in use\n' "$test_port" >&2
    return 1
  fi

  local server_bin client_bin
  server_bin="$(cabal list-bin "$server_target" | tail -n 1)"
  client_bin="$(cabal list-bin "$client_target" | tail -n 1)"

  "$server_bin" &
  server_pid=$!

  cleanup_server() {
    if kill -0 "$server_pid" 2>/dev/null; then
      kill "$server_pid" 2>/dev/null || true
      wait "$server_pid" 2>/dev/null || true
    fi
  }
  trap cleanup_server EXIT

  for _ in {1..100}; do
    if (echo >/dev/tcp/127.0.0.1/"$test_port") 2>/dev/null; then
      "$client_bin"
      cleanup_server
      trap - EXIT
      return
    fi
    if ! kill -0 "$server_pid" 2>/dev/null; then
      wait "$server_pid"
      return 1
    fi
    sleep 0.1
  done

  printf 'test server did not start on port %s\n' "$test_port" >&2
  return 1
}

run_wasm_test() {
  printf '\n==> WASM client test\n'
  wasm32-wasi-cabal build "$client_target"
}

run_ghcjs_test() {
  printf '\n==> GHCJS client test\n'
  cabal build \
    --with-compiler=javascript-unknown-ghcjs-ghc \
    --with-hc-pkg=javascript-unknown-ghcjs-ghc-pkg \
    "$client_target"
}

run_native_test

if command -v wasm32-wasi-cabal >/dev/null 2>&1; then
  run_wasm_test
else
  printf '\n==> skipping WASM client test (wasm32-wasi-cabal is unavailable)\n'
fi

if command -v javascript-unknown-ghcjs-ghc >/dev/null 2>&1 \
  && command -v javascript-unknown-ghcjs-ghc-pkg >/dev/null 2>&1; then
  run_ghcjs_test
else
  printf '\n==> skipping GHCJS client test (GHCJS compiler is unavailable)\n'
fi